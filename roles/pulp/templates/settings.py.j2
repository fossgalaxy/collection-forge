# vim: set syntax=python:
SECRET_KEY = "{{ pulp_secret_key }}"
CONTENT_ORIGIN = "http://{{ pulp_content_service }}:24816"
DATABASES = {
    "default": {
        "HOST": "postgres", 
        "ENGINE": "django.db.backends.postgresql", 
        "NAME": "{{ pulp_db_name }}", 
        "USER": "{{ pulp_db_user }}", 
        "PASSWORD": "{{ pulp_db_pass }}", 
        "PORT": "5432", 
        "CONN_MAX_AGE": 0, 
        "OPTIONS": {"sslmode": "prefer"}
    }
}
CACHE_ENABLED = True
REDIS_HOST = "{{ pulp_cache_service }}"
REDIS_PORT = {{ pulp_cache_port | default(6379) | int }}
REDIS_PASSWORD = "{{ pulp_cache_password | default('') }}"
ANSIBLE_API_HOSTNAME = "http://{{ pulp_api_service }}:24817"
ANSIBLE_CONTENT_HOSTNAME = "http://{{ pulp_content_service }}:24816/pulp/content"
ALLOWED_IMPORT_PATHS = ["/tmp"]
ALLOWED_EXPORT_PATHS = ["/tmp"]
TOKEN_SERVER = "http://{{ pulp_api_service }}:24817/token/"
TOKEN_AUTH_DISABLED = False
TOKEN_SIGNATURE_ALGORITHM = "ES256"
PUBLIC_KEY_PATH = "/etc/pulp/keys/container_auth_public_key.pem"
PRIVATE_KEY_PATH = "/etc/pulp/keys/container_auth_private_key.pem"
ANALYTICS = False
STATIC_ROOT = "/var/lib/operator/static/"
